# Database connection (private, encrypted in Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/master_agent?sslmode=require
# Default zero-cost option: OpenRouter free-only router.
OPENROUTER_API_KEY=
AI_DAILY_LIMIT=15
OPENROUTER_DAILY_LIMIT=12
GEMINI_DAILY_LIMIT=5
AI_MAX_OUTPUT_TOKENS=3500
# OPTIONAL: Gemini will not run without explicit confirmation this project is Free tier.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
MASTER_PASSWORD=
# Paid OPENAI_API_KEY is intentionally NOT used by Master-Agent free-only mode.
